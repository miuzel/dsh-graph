{
  "name": "dsh-graph",
  "version": "1.0.0",
  "icon": "icon.svg",
  "description": "A DeepSeek Harness plugin for graph-based goal management and kanban visualization.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "bin": {
    "goal-graph": "./bin/goal-graph.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "goals",
    "kanban",
    "graph",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/miuzel/dsh-graph.git"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.3 <0.2.3-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-settings": ">=0.2.2-rc.3 <0.2.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "promptAssets": {
      "layout": "source",
      "publicDir": "../prompts",
      "hostDir": "./prompts"
    }
  }
}
