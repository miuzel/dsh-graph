{
  "name": "dsh-graph-client",
  "version": "0.3.2",
  "description": "dsh-graph 的 client 半边：在 DSH Web 界面内渲染二维泳道目标看板（看板/详情/写操作工作台），host 半边注册 /api/dsh-graph REST 端点。",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "core",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "goals",
    "kanban",
    "graph",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/miuzel/dsh-graph.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "bash ../scripts/sync-core.sh && node -e \"require('node:fs').existsSync('core/ops.js') || (console.error('core 未同步'), process.exit(1))\"",
    "test": "node --test ../core/tests/*.test.ts"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime"]
    }
  }
}
