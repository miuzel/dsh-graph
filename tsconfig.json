{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "core-dist",
    "declaration": false
  },
  "include": ["core/*.ts"],
  "exclude": ["core/tests", "node_modules"]
}
