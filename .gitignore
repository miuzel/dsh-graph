node_modules
node_modules/
*.log
/tmp/
probe/

core-dist/

# g-319：构建产物隔离到独立 dist/ 目录（由 scripts/build.sh 自动生成）
dist/

# g-348：build.sh 的原子发布暂存根（`.dist-stage.XXXXXX/`，与 dist 同文件系统，
# 全部步骤成功后 `mv -T --exchange` 与 dist 原子互换；EXIT trap 负责清理）。
# 正常/失败路径都不残留；仅 SIGKILL 会留下惰性残留，故加忽略规则兜底。
/.dist-stage.*/
# 退化路径（mv 无 --exchange）用于暂存旧 dist 的临时名，同样兜底忽略。
/dist.prev.*/

# g-319：dsh-graph-host/core/*.js 是 core/*.ts 的编译产物，不再跟踪。
# dsh-graph-host/lib/client.js 是客户端模块拼接产物，不再跟踪。
# 构建流水线（pnpm build / pnpm prepack / npm prepare）自动编译到 dist/。
# GitHub 源码安装（github:owner/repo）通过 prepare 脚本自动触发构建。
dsh-graph-host/core/
dsh-graph-host/lib/client.js

# g-149：看板数据由 .dsh-graph 内层 Git 仓库独立管理；父代码仓库不再跟踪。
/.dsh-graph/

# 子代理在包目录、子 Agent cwd 或 linked worktree 跑 graph 工具时误 init 的 .dsh-graph 骨架
#（非项目数据、非 git 跟踪）——阻止污染 git status。已跟踪的根 .dsh-graph 不受影响（gitignore 只拒新文件）。
**/.dsh-graph/

# g-121：HANDOFF 旧版归档目录（<root>/handoffs/）不入 git——旧交接文件不提交入库
handoffs/

# g-142：worktree 目录不入 git——避免误提交 .worktrees/** 污染
.worktrees/
.pnpm-store/
