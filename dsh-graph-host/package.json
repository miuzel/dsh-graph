{
  "name": "dsh-graph",
  "version": "0.12.0-alpha",
  "description": "A DeepSeek Harness plugin for graph-based goal management and kanban visualization.",
  "license": "MIT",
  "type": "module",
  "main": "../dist/index.js",
  "exports": {
    ".": "../dist/index.js",
    "./client": "../dist/lib/client.js",
    "./cordis.patch.yml": "../dist/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "goals",
    "kanban",
    "graph",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/miuzel/dsh-graph.git"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
